{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "comfortline",
  "main": "./cloudflare/worker.mjs",
  "compatibility_date": "2026-11-20",
  "vars": { "INSTAGRAM_USER_ID": "17841456791586879", "INSTAGRAM_API_VERSION": "v27.0" },
  "triggers": { "crons": ["7,22,37,52 * * * *"] },
  "assets": {
    "directory": "./artifacts/comfortline-website/dist/public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "none"
  }
}

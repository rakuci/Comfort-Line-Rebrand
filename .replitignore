# The format of this file is identical to `.dockerignore`.
# It is used to reduce the size of deployed images to make the process of publishing faster.

# No need to store the pnpm store twice.
.local

# Regenerated by the website build.
artifacts/comfortline-website/public/img/**/*-400.webp
artifacts/comfortline-website/public/img/**/*-800.webp
artifacts/comfortline-website/public/img/**/*-1200.webp
